# העתק ל־.env.local והזן ערכים (הקובץ .env.local לא נכנס ל־git)

# Groq (Llama) — עדיפות על פני Gemini אם מוגדר. Vercel: Environment Variables + Redeploy.
GROQ_API_KEY=
# אופציונלי; ברירת מחדל: llama-3.3-70b-versatile
# GROQ_MODEL=

# Gemini — ל־Generate Workout + Personal Prog / המאמן (מקומי + Vercel). מספיק אחד מהשמות:
# יתרת קרדיט ₪: אין API רשמי — בדקו ב־https://aistudio.google.com/billing
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_AI_API_KEY=
# אופציונלי Generate (ברירת מחדל בקוד: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# המאמן — תכנות אימונים (generate_*/revise_*). ברירת מחדל: gemini-2.5-flash (איכות).
# IDs ישנים (2.0-flash וכו') ממופים אוטומטית ל־2.5.
PERSONAL_COACH_MODEL=gemini-2.5-flash
# צ'אט / קליטה / debrief — מודל זול יותר (ברירת מחדל בקוד: gemini-2.5-flash-lite)
# PERSONAL_COACH_CHAT_MODEL=gemini-2.5-flash-lite
# חירום בלבד: מילוי יום-יום אחרי כשל שבוע (יקר — כבוי כברירת מחדל)
# PERSONAL_COACH_DAY_BY_DAY=1
# אם Gemini נכשל / מפתח לא תקין — צ'אט נופל ל־GROQ_API_KEY (תכנות נשאר Gemini בלבד).
# אופציונלי: כמה תווים לשלוח ל־Groq כ־system (ברירת מחדל בקוד ~32000). מעל זה — תבנית דחוסה עם אותו סדר תחקור.
# GROQ_SYSTEM_MAX_CHARS=32000
# File Search store — מוח המאמן (ידע). לא נטען אוטומטית ב־brick chat / Confirm קצר.
GEMINI_FILE_SEARCH_STORE=

# תיקייה מקומית לסנכרון ידני (אופציונלי). ברירת מחדל: experiments/personal-coach/knowledge-inbox
# מקור Drive: https://drive.google.com/drive/u/0/folders/1WLMbabNpXZ80qJPwgrxAY2I77CdTboAo
# Folder ID: 1WLMbabNpXZ80qJPwgrxAY2I77CdTboAo
# דוגמה (Drive Desktop): COACH_KNOWLEDGE_DIR=G:\My Drive\Duck WOD
# COACH_KNOWLEDGE_DIR=

# Resend — אותו מפתח/שולח כמו דוח ניתור השבועי (GitHub Actions / RESEND_SECRETS.md).
# api/coach-feedback.js ו־weekly-analytics-report משתמשים באותם שמות:
#   RESEND_API_KEY (או RESEND_API_KEY_conmail), RESEND_FROM
# נמען coach debrief: COACH_FEEDBACK_TO || ANALYTICS_REPORT_TO || ariel.tahan@gmail.com
# אל תיצור מפתח Resend חדש — העתק את אותו RESEND_API_KEY שכבר עובד לאנליטיקס
# (מ־GitHub Actions secrets או Vercel Env) ל־.env.local לבדיקות מקומיות / tunnel.
# בלי RESEND_API_KEY לא נשלח מייל (production: הגדר את אותם vars ב־Vercel).
# RESEND_API_KEY=
# RESEND_FROM=DUCK-WOD <onboarding@resend.dev>
# ANALYTICS_REPORT_TO=ariel.tahan@gmail.com
# COACH_FEEDBACK_TO=ariel.tahan@gmail.com

# אנליטיקס — רק אם רוצה לבדוק את /api/event מקומית
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo

# Admin Dashboard — /admin.html (required to enable; keep secret)
# Set a strong password. Without this, the admin API returns 401 for everyone.
# Local: snapshots under data/admin-snapshots/ (gitignored).
# Vercel: filesystem is ephemeral — for production persistence use Blob/KV later.
# ADMIN_PASSWORD=your-secret-admin-password
# Used by /admin.html + /api/admin-snapshot + /api/admin-coach-sandbox
